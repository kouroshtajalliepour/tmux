#!/usr/bin/env bash
# Project picker (prefix+S). Picking an existing session just switches to
# it; picking a new project builds the standard layout:
#   0:main  anchor window, yours to do whatever with
#   1:code  2:term  3:ai (auto-starts `claude`)
# prefix+B relies on windows 1/2/3 being named exactly code/term/ai.

PROJECTS="$HOME/Documents"

selected=$(find "$PROJECTS" -mindepth 1 -maxdepth 4 -type d | fzf \
  --prompt=" Project  " \
  --pointer="▶" \
  --marker="✓" \
  --border=rounded \
  --height=100% \
  --layout=reverse \
  --info=inline \
  --preview 'ls -la --color=always {}' \
  --preview-window=right:50%:wrap \
  --color="bg+:#313244,bg:#1e1e2e,fg:#cdd6f4,fg+:#ffffff,hl:#cba6f7,hl+:#cba6f7,border:#cba6f7,prompt:#cba6f7,pointer:#cba6f7,marker:#cba6f7,spinner:#cba6f7,header:#9399b2,info:#9399b2")

[ -z "$selected" ] && exit 0

session=$(basename "$selected")

tmux has-session -t "$session" 2>/dev/null

if [ $? != 0 ]; then
  tmux new-session -d -s "$session" -n main -c "$selected"
  tmux new-window -t "$session" -n code -c "$selected"
  tmux new-window -t "$session" -n term -c "$selected"
  tmux new-window -t "$session" -n ai -c "$selected"
  tmux send-keys -t "${session}:ai" 'claude' Enter
  tmux select-window -t "${session}:code"
fi

tmux switch-client -t "$session"
