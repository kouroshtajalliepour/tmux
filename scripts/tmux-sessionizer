#!/usr/bin/env bash
# Project picker (prefix+S). Sessions are named "p-<folder>" so project
# sessions are easy to tell apart from everything else (sys, ad-hoc, ...).
#
# Projects come in two shapes:
#   - a worktree container (no .git of its own, each branch lives in its
#     own subdirectory - api-generator-system is the original example):
#     picking it prompts for a branch (existing or brand new - cancelling
#     does nothing at all), builds a worktree for it if needed, and opens
#     that branch's own session.
#   - a plain single-checkout repo: the FIRST time you pick one, it gets
#     auto-converted into a worktree container (current branch's contents
#     move into a branch-named subdirectory), then opens straight into
#     that branch - no prompt needed, you were already on it. Every
#     later pick of that project takes the worktree-container path above.
# Either way, the built session is the standard layout:
#   0:main  anchor window, yours to do whatever with
#   7:code  8:term  9:ai (resumes/starts a claude session named
#     "project:branch", only if that window is actually idle)
# Windows 1-6 are left free for whatever extra terminals you add yourself.
# prefix+B relies on there being windows named exactly code/term/ai
# (wherever they end up), not on these specific indices.

source "$(dirname "$0")/fzf_common.sh"
source "$(dirname "$0")/project_lib.sh"
fzf_vim_nav_args " Project  "

PROJECTS="$HOME/Documents"

candidates=()
while IFS= read -r dir; do
  parent=$(dirname "$dir")
  is_worktree_container "$parent" && continue
  candidates+=("$dir")
done < <(find "$PROJECTS" -mindepth 1 -maxdepth 4 -type d)

# show paths relative to ~/Documents (the full absolute path is still the
# hidden first field, used for every actual operation below)
rows=$(printf '%s\n' "${candidates[@]}" | awk -v prefix="$PROJECTS/" '{rel = $0; sub("^" prefix, "", rel); printf "%s\t%s\n", $0, rel}')

selected=$(printf '%s\n' "$rows" | fzf \
  --prompt=" Project  " \
  --pointer="▶" \
  --marker="✓" \
  --border=rounded \
  --height=100% \
  --layout=reverse \
  --info=inline \
  --delimiter=$'\t' \
  --with-nth=2.. \
  --preview 'ls -la --color=always {1}' \
  --preview-window=right:50%:wrap \
  "${FZF_VIM_NAV_ARGS[@]}" \
  --color="$FZF_CATPPUCCIN_COLOR")

selected=${selected%%$'\t'*}
[ -z "$selected" ] && exit 0

if is_worktree_container "$selected"; then
  project_name=$(basename "$selected")
  main_dir=$(find_main_worktree "$selected")

  branch=$(pick_or_create_branch "$main_dir")
  [ -z "$branch" ] && exit 0

  branch_dir=$(basename "$branch")
  worktree_dir="$selected/$branch_dir"

  if [ ! -d "$worktree_dir" ]; then
    if git -C "$main_dir" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$main_dir" worktree add "$worktree_dir" "$branch"
    elif git -C "$main_dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$main_dir" worktree add "$worktree_dir" -b "$branch" --track "origin/$branch"
    else
      git -C "$main_dir" worktree add "$worktree_dir" -b "$branch"
    fi
  fi

  session="p-${project_name}-${branch_dir}"
  build_project_session "$worktree_dir" "$session" "$project_name"

elif [ -d "$selected/.git" ]; then
  project_name=$(basename "$selected")
  branch_dir=$(convert_to_worktree_container "$selected")
  worktree_dir="$selected/$branch_dir"

  session="p-${project_name}-${branch_dir}"
  build_project_session "$worktree_dir" "$session" "$project_name"

else
  session="p-$(basename "$selected")"
  build_project_session "$selected" "$session" "$(basename "$selected")"
fi
