#!/usr/bin/env bash
# Project picker (prefix+S). Sessions are named "p-<folder>" so project
# sessions are easy to tell apart from everything else (sys, ad-hoc, ...).
# Picking an existing session just switches to it; picking a new project
# builds the standard layout:
#   0:main  anchor window, yours to do whatever with
#   7:code  8:term  9:ai (resumes/starts a claude session named
#     "project:branch", only if that window is actually idle)
# Windows 1-6 are left free for whatever extra terminals you add yourself.
# prefix+B relies on there being windows named exactly code/term/ai
# (wherever they end up), not on these specific indices.

source "$(dirname "$0")/fzf_common.sh"
fzf_vim_nav_args " Project  "

PROJECTS="$HOME/Documents"

selected=$(find "$PROJECTS" -mindepth 1 -maxdepth 4 -type d | fzf \
  --prompt=" Project  " \
  --pointer="▶" \
  --marker="✓" \
  --border=rounded \
  --height=100% \
  --layout=reverse \
  --info=inline \
  --preview 'ls -la --color=always {}' \
  --preview-window=right:50%:wrap \
  "${FZF_VIM_NAV_ARGS[@]}" \
  --color="$FZF_CATPPUCCIN_COLOR")

[ -z "$selected" ] && exit 0

session="p-$(basename "$selected")"

tmux has-session -t "$session" 2>/dev/null

if [ $? != 0 ]; then
  tmux new-session -d -s "$session" -n main -c "$selected"
  tmux set-option -t "$session" renumber-windows off
  tmux new-window -t "${session}:7" -n code -c "$selected"
  tmux new-window -t "${session}:8" -n term -c "$selected"
  tmux new-window -t "${session}:9" -n ai -c "$selected"
  "$(dirname "$0")/ai_launch.sh" "$selected" "${session}:9"
  tmux select-window -t "${session}:7"
fi

tmux switch-client -t "$session"
